{
  "kind": "collectionType",
  "collectionName": "borrow_records",
  "info": {
    "singularName": "borrow-record",
    "pluralName": "borrow-records",
    "displayName": "BorrowRecord"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "borrowDate": {
      "type": "date"
    },
    "dueDate": {
      "type": "date"
    },
    "returnDate": {
      "type": "date"
    },
    "statusborrowStatus": {
      "type": "enumeration",
      "enum": [
        "borrowed",
        " returned",
        " overdue"
      ]
    },
    "member": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::member.member",
      "inversedBy": "borrow_records"
    },
    "book_item": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::book-item.book-item",
      "inversedBy": "borrow_records"
    },
    "fine_amount": {
      "type": "biginteger"
    }
  }
}
