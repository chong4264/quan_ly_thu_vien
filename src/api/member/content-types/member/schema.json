{
  "kind": "collectionType",
  "collectionName": "members",
  "info": {
    "singularName": "member",
    "pluralName": "members",
    "displayName": "Member"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string"
    },
    "memberCode": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "statuss": {
      "type": "enumeration",
      "enum": [
        "active",
        " expired",
        " suspended"
      ]
    },
    "borrow_records": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::borrow-record.borrow-record",
      "mappedBy": "member"
    }
  }
}
