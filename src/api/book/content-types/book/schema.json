{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "Book"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "isbn": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "publishedYear": {
      "type": "integer"
    },
    "totalCopies": {
      "type": "integer"
    },
    "availableCopies": {
      "type": "integer"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "books"
    },
    "description": {
      "type": "text"
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "book_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book-item.book-item",
      "mappedBy": "book"
    }
  }
}
